# Local app
DATABASE_PATH=./data/naijavote.db
CORS_ORIGINS=http://localhost:8000
ADMIN_API_TOKEN=replace-with-a-long-random-secret
RISK_PROXIMITY_KM=10
# Per-client limits. Set to 0 to disable a limit.
ASK_RATE_LIMIT_PER_MINUTE=60
PUBLIC_READ_RATE_LIMIT_PER_MINUTE=120
ADMIN_RATE_LIMIT_PER_MINUTE=30
# WhatsApp webhook limits are enforced before parsing provider form fields.
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
WEBHOOK_MAX_BODY_BYTES=65536
# Request body caps (bytes). Import uses the larger admin import cap.
MAX_REQUEST_BODY_BYTES=1048576
MAX_ADMIN_IMPORT_BYTES=20000000
# Only enable behind a trusted proxy that overwrites forwarded client headers.
TRUST_PROXY_HEADERS=false
# Keep API docs on locally; set false in production or protect them at the gateway.
ENABLE_API_DOCS=false

# NiMet credentials are requested at https://api.nimet.gov.ng/.
# The endpoint path and response shape must be matched to your provisioned API product.
NIMET_API_KEY=
NIMET_ENDPOINT=

# NIHSA subscriber feed adapter (configure only with an authorized feed URL and schema).
NIHSA_FEED_URL=
NIHSA_API_TOKEN=

# Optional future integrations. Never commit real secrets.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_WEBHOOK_URL=
WHATSAPP_FROM=

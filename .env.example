# Local app
DATABASE_PATH=./data/naijavote.db
CORS_ORIGINS=http://localhost:8000
ADMIN_API_TOKEN=replace-with-a-long-random-secret
RISK_PROXIMITY_KM=10

# NiMet credentials are requested at https://api.nimet.gov.ng/.
# The endpoint path and response shape must be matched to your provisioned API product.
NIMET_API_KEY=
NIMET_ENDPOINT=

# NIHSA subscriber feed adapter (configure only with an authorized feed URL and schema).
NIHSA_FEED_URL=
NIHSA_API_TOKEN=

# Optional future integrations. Never commit real secrets.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_WEBHOOK_URL=
WHATSAPP_FROM=
